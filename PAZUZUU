local function _startInstaReturn(savedCFrame, duration)
    local startTime = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if tick() - startTime > (duration or 0.8) then
            conn:Disconnect()
            return
        end
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.CFrame = savedCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
            end)
        end
    end)
end

local function performVoid(targetPlayer)
    task.spawn(function()
        if not targetPlayer or not targetPlayer.Character then return end
        local mySavedCFrame = nil
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            mySavedCFrame = player.Character.HumanoidRootPart.CFrame
        end

        pcall(function()
            if CarryRequest then
                CarryRequest:FireServer(table.unpack({
                    [1] = targetPlayer, [2] = CONFIG.InstaGymLength, [3] = CONFIG.InstaGymHeight, [4] = CONFIG.InstaGymDistance, [5] = 0, [6] = 0, [7] = 0,
                }))
            end
        end)
        task.wait(0.12)
        pcall(function() if EventTeleportEvent then EventTeleportEvent:FireServer() end end)
        task.wait(0.08)
        pcall(function() if StopCarry then StopCarry:FireServer() end end)

        if mySavedCFrame then
            pcall(function()
                local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = mySavedCFrame
                    hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                end
            end)
            _startInstaReturn(mySavedCFrame, 0.8)
        end
    end)
end

local function performAutoBring(targetPlayer, customDestPos, onComplete)
    task.spawn(function()
        if not targetPlayer or not targetPlayer.Character then 
            if onComplete then onComplete() end
            return 
        end
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then 
            if onComplete then onComplete() end
            return 
        end

        local destPos = customDestPos or hrp.Position
        local mySpot = hrp.CFrame

        local argX = EVENT_X - destPos.X
        local argY = EVENT_Y - destPos.Y
        local argZ = EVENT_Z - destPos.Z

        pcall(function()
            if CarryRequest then
                CarryRequest:FireServer(table.unpack({
                    [1] = targetPlayer, [2] = argX, [3] = argY, [4] = argZ, [5] = 0, [6] = 0, [7] = 0,
                }))
            end
        end)
        task.wait(0)
        pcall(function() if EventTeleportEvent then EventTeleportEvent:FireServer() end end)
        task.wait(0)
        pcall(function() if StopCarry then StopCarry:FireServer() end end)

        pcall(function()
            if hrp and hrp.Parent then
                hrp.CFrame = mySpot
                hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
            end
        end)

        local startTime = tick()
        local conn
        conn = RunService.Heartbeat:Connect(function()
            if tick() - startTime > 0.3 then 
                conn:Disconnect() 
                if onComplete then onComplete() end
                return 
            end
            local h = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if h then
                pcall(function()
                    h.CFrame = mySpot
                    h.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                end)
            end
        end)
    end)
end

