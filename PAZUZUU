local function isBlocked(track)
    if not track or not track.Animation then return false end
    local id = string.match(track.Animation.AnimationId, "%d+")
    -- If ID is in the blocklist AND NOT in the exempt list, block it
    return (id and BLOCKED_IDS[id] and not EXEMPT_IDS[id])
end

