-- Bring: teleports target player TO you (uses carry/teleport exploit logic)
local function performBring(targetPlayer, customPos)
    task.spawn(function()
        if not targetPlayer or not targetPlayer.Character then return end
        local hrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local destPos = customPos
        if not destPos then
            local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if not myHrp then return end
            destPos = myHrp.Position + Vector3.new(0, 0, 3)
        end
        -- Use carry/teleport trick: carry them, teleport them to pos, then stop carry
        pcall(function()
            if CarryRequest then
                CarryRequest:FireServer(table.unpack({
                    [1] = targetPlayer,
                    [2] = 0, [3] = 300, [4] = 0,
                    [5] = 0, [6] = 0, [7] = 0,
                }))
            end
        end)
        task.wait(0.12)
        pcall(function()
            if EventTeleportEvent then EventTeleportEvent:FireServer() end
        end)
        task.wait(0.08)
        pcall(function()
            if StopCarry then StopCarry:FireServer() end
        end)
        -- Now force target's HRP to the destination (client-side exploit)
        task.spawn(function()
            for i = 1, 15 do
                local tHrp = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if tHrp then
                    pcall(function()
                        tHrp.CFrame = CFrame.new(destPos)
                        tHrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                    end)
                end
                task.wait(0.05)
            end
        end)
    end)
end

-- Void: teleports target player to a custom position (default: below map)
local function performVoid(targetPlayer, customPos)
    task.spawn(function()
        if not targetPlayer or not targetPlayer.Character then return end
        local destPos = customPos or CONFIG.VoidPosition
        local tHrp = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not tHrp then return end

        -- First, use carry trick to try to relocate them
        pcall(function()
            if CarryRequest then
                CarryRequest:FireServer(table.unpack({
                    [1] = targetPlayer,
                    [2] = 0, [3] = 300, [4] = 0,
                    [5] = 0, [6] = 0, [7] = 0,
                }))
            end
        end)
        task.wait(0.12)
        pcall(function()
            if EventTeleportEvent then EventTeleportEvent:FireServer() end
        end)
        task.wait(0.08)
        pcall(function()
            if StopCarry then StopCarry:FireServer() end
        end)

        -- Then force void position on them (client-side)
        task.spawn(function()
            for i = 1, 20 do
                local h = targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")
                if h then
                    pcall(function()
                        h.CFrame = CFrame.new(destPos)
                        h.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                    end)
                end
                task.wait(0.05)
            end
        end)
    end)
end

