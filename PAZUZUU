local function parseList(str) local t={} if str=="" then return t end for w in str:gmatch("%S+") do table.insert(t,w:lower()) end return t end
local function isTarget(n, list) if #list==0 then return true end local ln=n:lower() for _,v in ipairs(list) do if ln:find(v,1,true) then return true end end return false end
local function isSafe(n, list) local ln=n:lower() for _,v in ipairs(list) do if ln:find(v,1,true) then return true end end return false end
local function isSafePlayer(plr) if not plr or CONFIG.SafeList=="" then return false end for w in string.gmatch(CONFIG.SafeList,"%S+") do if string.lower(w)==string.lower(plr.Name) or string.lower(w)==string.lower(plr.DisplayName) then return true end end return false end

local function getPlayerByName(name)
    if not name or name == "" then return nil end
    name = name:lower()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and (p.Name:lower():find(name,1,true) or p.DisplayName:lower():find(name,1,true)) then
            return p
        end
    end
    return nil
end

-- Cleanup Function
local function ResetAllHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local sphere = hrp:FindFirstChild("KillAuraSphere")
                if sphere then sphere:Destroy() end
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.Material = Enum.Material.Plastic
                hrp.CanCollide = true
            end
        end
    end
end

