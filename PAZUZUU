    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _,s in ipairs({Enum.HumanoidStateType.Ragdoll,Enum.HumanoidStateType.Physics,Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.PlatformStanding}) do pcall(function() hum:SetStateEnabled(s,false) end) end
