local function setupAntiGrab(char)
    local hum = char:WaitForChild("Humanoid", 10)
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    if not hum or not hrp then return end
    hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if not CONFIG.AntiGrabEnabled then return end
        if hum.PlatformStand then
            local originalPos = hrp.Position
            if EventTeleportEvent then EventTeleportEvent:FireServer() end
            task.delay(CONFIG.antiGrabDelay, function()
                local currentHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                if currentHrp then currentHrp.CFrame = CFrame.new(originalPos) end
            end)
        end
    end)
end

local function setupCharacter(character)
    if not character then return end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        CONFIG.LastHealth=humanoid.Health
        humanoid.HealthChanged:Connect(function(nh)
            if nh<CONFIG.LastHealth and nh>0 then
                local myHRP=character:FindFirstChild("HumanoidRootPart")
                if myHRP then
                    local closest,dist=nil,30
                    for _,plr in ipairs(Players:GetPlayers()) do
                        if plr~=player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and not isSafePlayer(plr) then
                            local d=(plr.Character.HumanoidRootPart.Position-myHRP.Position).Magnitude
                            if d<dist then dist=d closest=plr.Name end
                        end
                    end
                    if closest then doLocalTeleport(character,closest) end
                end
                if CONFIG.AntiHit15Enabled and not CONFIG.AntiHit15Cooldown then
                    CONFIG.AntiHit15Cooldown=true
                    local hrp=character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local orig=hrp.CFrame
                        task.spawn(function() pcall(function()
                            if EventTeleportEvent then EventTeleportEvent:FireServer() end
                            if ClassTeleportEvent then ClassTeleportEvent:FireServer() end
                            task.wait(1.5)
                            if StopCarry then StopCarry:FireServer() end
                            task.wait(0.1)
                            for i=1,5 do if hrp and hrp.Parent then hrp.CFrame=orig hrp.AssemblyLinearVelocity=Vector3.new(0,0,0) hrp.AssemblyAngularVelocity=Vector3.new(0,0,0) end task.wait(0.05) end
                            task.wait(0.5) CONFIG.AntiHit15Cooldown=false
                        end) end)
                    end
                end
            end
            CONFIG.LastHealth=nh
        end)
    end
    task.wait(0.2) preloadFastAnim() preloadTpWalkAnim()
    local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
    if animator then animator.AnimationPlayed:Connect(function(t) if t.Priority==Enum.AnimationPriority.Action or t.Priority==Enum.AnimationPriority.Core then CONFIG.SavedEmoteID=t.Animation.AnimationId end end) end
    if humanoid then humanoid.UseJumpPower=true humanoid.JumpPower=CONFIG.JumpPower end

    task.spawn(setupAntiGrab, character)
end

