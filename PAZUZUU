local function setAutoBlock(state)
    if not BlockRF then warn("[AutoBlock] Block remote not found") return end
    CONFIG.AutoBlockEnabled = state
    if state then
        pcall(function() BlockRF:InvokeServer(true) end)
        if CONFIG.AutoBlockConn then CONFIG.AutoBlockConn:Disconnect() end
        CONFIG.AutoBlockConn = RunService.Heartbeat:Connect(function()
            task.wait(0.01)
            if CONFIG.AutoBlockEnabled then pcall(function() BlockRF:InvokeServer(true) end) end
        end)
    else
        if CONFIG.AutoBlockConn then CONFIG.AutoBlockConn:Disconnect() CONFIG.AutoBlockConn=nil end
        pcall(function() BlockRF:InvokeServer(false) end)
    end
end

