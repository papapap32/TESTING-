local _insta_returnConn = nil

local function _startInstaReturn(savedCFrame, duration)
    if _insta_returnConn then
        _insta_returnConn:Disconnect()
        _insta_returnConn = nil
    end
    if not savedCFrame then return end
    local startTime = tick()
    _insta_returnConn = RS.Heartbeat:Connect(function()
        if tick() - startTime > (duration or 0.8) then
            if _insta_returnConn then
                _insta_returnConn:Disconnect()
                _insta_returnConn = nil
            end
            return
        end
        local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                hrp.CFrame = savedCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
            end)
        end
    end)
end

local function performInsta()
    task.spawn(function()
        local targetPlayer = CONFIG.InstaTarget
        if not targetPlayer then return end
        local mySavedCFrame = nil
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            mySavedCFrame = player.Character.HumanoidRootPart.CFrame
        end

        if targetPlayer and targetPlayer.Character then
            pcall(function()
                if CarryRequest then
                    CarryRequest:FireServer(table.unpack({
                        [1] = targetPlayer,
                        [2] = CONFIG.InstaGymLength,
                        [3] = CONFIG.InstaGymHeight,
                        [4] = CONFIG.InstaGymDistance,
                        [5] = 0, [6] = 0, [7] = 0,
                    }))
                end
            end)
            task.wait(0.12)
            pcall(function()
                if EventTeleportEvent then EventTeleportEvent:FireServer() end
            end)
            task.wait(0.08)
            pcall(function()
                if StopCarry then StopCarry:FireServer() end
            end)

            if mySavedCFrame then
                pcall(function()
                    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = mySavedCFrame
                        hrp.AssemblyLinearVelocity = Vector3.new(0, -1, 0)
                    end
                end)
                _startInstaReturn(mySavedCFrame, 0.8)
            end
        end
    end)
end

