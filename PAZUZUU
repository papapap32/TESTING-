local _arc_targetCFrame = CFrame.new(-502.844818, 10.1868954, -65.4427567, 0.560596228, 2.67291544e-09, -0.828089297, -2.95736768e-08, 1, -1.67928462e-08, 0.828089297, 3.39036497e-08, 0.560596228)
local _arc_safeCFrame = _arc_targetCFrame + Vector3.new(0,1,0)
local ArcDefaultDelay=0.1 ArcGrabDelay=3.5
local _arc_connection,_arc_platStandConn=nil,nil
local _arc_originalCFrame=nil _arc_hasCleanedThisRagdoll=false _arc_returnTask=nil _arc_inReturnWindow=false _arc_wasGrabbed=false
local _arc_platform=nil _arc_platformStandConn=nil

local function _arc_resetState() _arc_originalCFrame=nil _arc_returnTask=nil _arc_hasCleanedThisRagdoll=false _arc_inReturnWindow=false _arc_wasGrabbed=false end
local function _arc_removePlatform()
    if _arc_platformStandConn then _arc_platformStandConn:Disconnect() _arc_platformStandConn=nil end
    if _arc_platform then pcall(function() _arc_platform:Destroy() end) _arc_platform=nil end
end
local function _arc_spawnPlatform(position)
    _arc_removePlatform()
    local W,H,D,T=16,10,16,1
    local floorY=position.Y-3.5 local floorCY=floorY-T/2 local ceilCY=floorY+H+T/2 local innerCY=floorY+H/2
    local model=Instance.new("Model") model.Name="ARC_SafeBox" model.Parent=workspace _arc_platform=model
    local function mp(s,cf) local p=Instance.new("Part") p.Size=s p.CFrame=cf p.Anchored=true p.CanCollide=true p.Locked=true p.Material=Enum.Material.SmoothPlastic p.BrickColor=BrickColor.new("Medium stone grey") p.Transparency=0.4 p.Parent=model return p end
    local cx,cz=position.X,position.Z
    mp(Vector3.new(W,T,D),CFrame.new(cx,floorCY,cz)) mp(Vector3.new(W,T,D),CFrame.new(cx,ceilCY,cz))
    mp(Vector3.new(W,H+T*2,T),CFrame.new(cx,innerCY,cz+D/2+T/2)) mp(Vector3.new(W,H+T*2,T),CFrame.new(cx,innerCY,cz-D/2-T/2))
    mp(Vector3.new(T,H+T*2,D),CFrame.new(cx-W/2-T/2,innerCY,cz)) mp(Vector3.new(T,H+T*2,D),CFrame.new(cx+W/2+T/2,innerCY,cz))
    local topY=floorY
    _arc_platformStandConn=RS.Heartbeat:Connect(function()
        if not _arc_platform or not _arc_platform.Parent then _arc_removePlatform() return end
        local hrp=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Parent and hrp.Position.Y<topY then hrp.CFrame=CFrame.new(cx,topY+3.5,cz) hrp.AssemblyLinearVelocity=Vector3.new(0,0,0) end
    end)
end
local function _arc_countDisabledMotors(char)
    if not char then return 0,0 end
    local total,disabled=0,0
    for _,o in ipairs(char:GetDescendants()) do if o:IsA("Motor6D") then total+=1 if not o.Enabled then disabled+=1 end end end
    return total,disabled
end
local function _arc_forceEndRagdoll(char)
    if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then
        for _,s in ipairs({Enum.HumanoidStateType.Ragdoll,Enum.HumanoidStateType.Physics,Enum.HumanoidStateType.FallingDown,Enum.HumanoidStateType.PlatformStanding}) do pcall(function() hum:SetStateEnabled(s,false) end) end
        hum.PlatformStand=false hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
    for _,n in ipairs({"RagdollJoints","NoCollisions","Local Ragdoll"}) do local o=char:FindFirstChild(n) if o then o:Destroy() end end
    for _,o in ipairs(char:GetDescendants()) do
        if o:IsA("Motor6D") then o.Enabled=true
        elseif (o:IsA("BaseConstraint") or o:IsA("Attachment")) and o.Name:lower():find("ragdoll") then o:Destroy() end
    end
end
local function _arc_onCharacterAdded(char)
    local hrp=char:WaitForChild("HumanoidRootPart",10) local hum=char:WaitForChild("Humanoid",10)
    if not hrp or not hum then return end
    if _arc_connection then _arc_connection:Disconnect() _arc_connection=nil end
    if _arc_platStandConn then _arc_platStandConn:Disconnect() _arc_platStandConn=nil end
    _arc_resetState()
    if _arc_returnTask then task.cancel(_arc_returnTask) _arc_returnTask=nil end
    task.wait(2.5)
    if not CONFIG.AntiRagEnabled and not CONFIG.AntiGrabRagEnabled then return end
    _arc_connection=RS.Heartbeat:Connect(function()
        if not CONFIG.AntiRagEnabled then return end
        if not char.Parent or not hrp.Parent then if _arc_connection then _arc_connection:Disconnect() _arc_connection=nil end return end
        if _arc_inReturnWindow then return end
        local total,disabled=_arc_countDisabledMotors(char)
        local isRag=total>=12 and (disabled/total)>=0.9
        if isRag then
            if not _arc_originalCFrame then _arc_originalCFrame=hrp.CFrame end
            if not _arc_hasCleanedThisRagdoll then hrp.CFrame=_arc_safeCFrame _arc_forceEndRagdoll(char) _arc_hasCleanedThisRagdoll=true end
        else
            if _arc_originalCFrame and not _arc_returnTask then
                _arc_inReturnWindow=true local saved=_arc_originalCFrame
                _arc_returnTask=task.delay(ArcDefaultDelay,function()
                    if hrp and hrp.Parent and saved then hrp.CFrame=saved task.delay(0.05,function() if hrp and hrp.Parent then hrp.AssemblyLinearVelocity=Vector3.new(0,-1,0) end end) end
                    _arc_resetState()
                end)
            end
            _arc_hasCleanedThisRagdoll=false
        end
    end)
end
local function startARC() local c=player.Character if c then task.spawn(_arc_onCharacterAdded,c) end end
local function stopARC() if not CONFIG.AntiRagEnabled and not CONFIG.AntiGrabRagEnabled then
    if _arc_connection then _arc_connection:Disconnect() _arc_connection=nil end
    if _arc_platStandConn then _arc_platStandConn:Disconnect() _arc_platStandConn=nil end
    _arc_removePlatform() end end

