local function doLocalTeleport(character, attackerName)
    if not CONFIG.AntiHitEnabled or not character or CONFIG.Cooldown then return end
    local attacker=Players:FindFirstChild(attackerName)
    if not attacker or not attacker.Character or isSafePlayer(attacker) then return end
    local hrp=character:FindFirstChild("HumanoidRootPart") if not hrp then return end
    CONFIG.Cooldown=true
    local orig=hrp.CFrame
    if StopCarry then pcall(function() StopCarry:FireServer() end) end
    if CarryRequest then pcall(function() CarryRequest:FireServer(attacker,1,0,1,0,180,0) end) end
    if AcceptRequest then for i=1,5 do pcall(function() AcceptRequest:FireServer(attacker) end) pcall(function() AcceptRequest:FireServer() end) task.wait(0.05) end end
    task.spawn(function() task.wait(0.1) if EventTeleportEvent then pcall(function() EventTeleportEvent:FireServer() end) end end)
    task.delay(2.0, function()
        local hum=character:FindFirstChildOfClass("Humanoid")
        if hrp.Parent and hum and hum.Health>0 then hrp.CFrame=orig hrp.AssemblyLinearVelocity=Vector3.new(0,0,0) end
        if StopCarry then pcall(function() StopCarry:FireServer() end) end
        task.wait(0.5) CONFIG.Cooldown=false
    end)
end

