RunService.Heartbeat:Connect(function()
    if not CONFIG.ShieldEnabled or not player.Character then return end
    local hrp = player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local box = hrp:FindFirstChild("RepelShieldBox")
    if not box then
        box = Instance.new("Part")
        box.Name = "RepelShieldBox"
        box.Shape = Enum.PartType.Ball
        box.Anchored = true
        box.CanCollide = false
        box.Material = Enum.Material.ForceField
        box.Color = Color3.fromRGB(0, 150, 255)
        box.Transparency = 0.7
        box.Parent = hrp
    end
    box.Size = Vector3.new(CONFIG.ShieldSize * 2, CONFIG.ShieldSize * 2, CONFIG.ShieldSize * 2)
    box.CFrame = hrp.CFrame

    if isPushing then return end

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local tHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local tHum = p.Character:FindFirstChildOfClass("Humanoid")
            
            if tHRP and tHum and tHum.Health > 0 then
                if not isSafePlayer(p) then
                    local dist = (tHRP.Position - hrp.Position).Magnitude
                    
                    if dist <= CONFIG.ShieldSize then
                        isPushing = true
                        
                        local myLook = hrp.CFrame.LookVector
                        local pushPos = hrp.Position + (myLook * (CONFIG.ShieldSize + CONFIG.ShieldPushDistance))
                        
                        performAutoBring(p, pushPos, function()
                            isPushing = false
                        end)
                        
                        break
                    end
                end
            end
        end
    end
end)

